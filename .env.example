# Optional. When set, the app and migrations use this PostgreSQL server (node-postgres driver).
# When unset, the app runs an embedded PGlite database stored under ./.data/pglite.
# Example for a local server: postgresql://postgres:password@localhost:5432/miraflores
# Passwords with special characters must be URL-encoded (for example @ becomes %40).
DATABASE_URL=

# Optional. Path to the packet fixture. Defaults to data/packet.json.
PACKET_PATH=

# Optional. Directory for the embedded PGlite database. Defaults to ./.data/pglite.
PGLITE_DIR=
